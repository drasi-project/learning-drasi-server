{
    "name": "Drasi Server - High Risk Containers Tutorial",
    // Server and all plugins are built together inside this container.
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04@sha256:d94c97dd9cacf183d0a6fd12a8e87b526e9e928307674ae9c94139139c0c6eae",
    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:2": {
            "version": "29",
            "moby": false
        },
        "ghcr.io/devcontainers/features/git:1": {},
        "ghcr.io/devcontainers/features/rust:1": {
            "version": "1.95.0"
        },
        "ghcr.io/devcontainers/features/common-utils:2": {
            "installZsh": true,
            "configureZshAsDefaultShell": true
        },
        "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
            "minikube": "none"
        }
    },
    "postCreateCommand": "bash ../../.devcontainer/high-risk-containers/post-create.sh",
    "workspaceMount": "source=${localWorkspaceFolder}/..,target=/workspaces,type=bind",
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/tutorials/high-risk-containers",
    "runArgs": [
        "--privileged",
        "--init",
        "--ipc=host"
    ],
    "forwardPorts": [
        8380,
        3000,
        5732
    ],
    "portsAttributes": {
        "8380": {
            "label": "Drasi Server API",
            "onAutoForward": "notify"
        },
        "3000": {
            "label": "High Risk Containers Dashboard",
            "onAutoForward": "notify"
        },
        "5732": {
            "label": "PostgreSQL",
            "onAutoForward": "silent"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "humao.rest-client"
            ],
            "settings": {
                "editor.formatOnSave": true
            }
        }
    },
    "remoteUser": "vscode",
    "remoteEnv": {
        "LOCAL_WORKSPACE_FOLDER": "${localWorkspaceFolder}"
    },
    "containerEnv": {
        "CONTAINER_ENGINE": "docker",
        "CARGO_TARGET_DIR": "/home/vscode/.cache/drasi-high-risk-containers/target",
        "CARGO_BUILD_JOBS": "1",
        "CARGO_INCREMENTAL": "0",
        "CARGO_PROFILE_DEV_DEBUG": "0",
        "POSTGRES_HOST": "localhost",
        "POSTGRES_PORT": "5732",
        "POSTGRES_HOST_PORT": "5732",
        "SERVER_PORT": "8380",
        "DASHBOARD_PORT": "3000"
    }
}
