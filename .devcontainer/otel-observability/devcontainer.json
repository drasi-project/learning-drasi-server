{
    "name": "Drasi Server - OTel Observability Tutorial",
    // Build Server and every plugin inside this same Linux environment.
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04@sha256:d94c97dd9cacf183d0a6fd12a8e87b526e9e928307674ae9c94139139c0c6eae",
    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:2": {
            "version": "29",
            "moby": false
        },
        "ghcr.io/devcontainers/features/git:1": {},
        "ghcr.io/devcontainers/features/rust:1": {
            "version": "1.95.0"
        },
        "ghcr.io/devcontainers/features/common-utils:2": {
            "installZsh": true,
            "configureZshAsDefaultShell": true
        },
        "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
            "minikube": "none"
        }
    },
    "postCreateCommand": "bash ../../.devcontainer/otel-observability/post-create.sh",
    "workspaceMount": "source=${localWorkspaceFolder}/..,target=/workspaces,type=bind",
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/tutorials/otel-observability",
    "runArgs": [
        "--privileged",
        "--init",
        "--ipc=host"
    ],
    "forwardPorts": [
        8380,
        3000,
        5732,
        14317,
        14318,
        18080
    ],
    "portsAttributes": {
        "8380": {
            "label": "Drasi Server API",
            "onAutoForward": "notify"
        },
        "3000": {
            "label": "OTel Observability Dashboard",
            "onAutoForward": "notify"
        },
        "5732": {
            "label": "PostgreSQL",
            "onAutoForward": "silent"
        },
        "14317": {
            "label": "Drasi OTLP",
            "onAutoForward": "silent"
        },
        "18080": {
            "label": "Checkout control API",
            "onAutoForward": "silent"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "humao.rest-client"
            ],
            "settings": {
                "editor.formatOnSave": true
            }
        }
    },
    "remoteUser": "vscode",
    "remoteEnv": {
        "LOCAL_WORKSPACE_FOLDER": "${localWorkspaceFolder}"
    },
    "containerEnv": {
        "CONTAINER_ENGINE": "docker",
        "DOCKER_HOST": "unix:///var/run/docker.sock",
        "DRASI_DEMO_DIR": "/home/vscode/.cache/drasi-otel-observability/runtime",
        "CARGO_TARGET_DIR": "/home/vscode/.cache/drasi-otel-observability/target",
        "CARGO_BUILD_JOBS": "1",
        "CARGO_INCREMENTAL": "0",
        "CARGO_PROFILE_DEV_DEBUG": "0",
        "SERVER_HOST": "0.0.0.0",
        "DASHBOARD_HOST": "0.0.0.0",
        "POSTGRES_HOST": "localhost",
        "POSTGRES_PORT": "5732",
        "SERVER_PORT": "8380",
        "DASHBOARD_PORT": "3000",
        "CHECKOUT_CONTROL_PORT": "18080",
        "OTEL_GRPC_PORT": "14317",
        "OTEL_HTTP_PORT": "14318"
    }
}
