{
    "name": "Drasi Server - Getting Started Tutorial",
    "image": "mcr.microsoft.com/devcontainers/base:bookworm@sha256:9e35ebf156350ba25b117da6869907034b6e2437b1891e3a43395af0b7d3eda4",
    "features": {
        "ghcr.io/devcontainers/features/git:1": {},
        "ghcr.io/devcontainers/features/rust:1": {"version": "1.95.0"},
        "ghcr.io/devcontainers/features/common-utils:2": {
            "installZsh": true,
            "configureZshAsDefaultShell": true
        }
    },
    "workspaceMount": "source=${localWorkspaceFolder}/..,target=/workspaces,type=bind",
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/tutorials/getting-started",
    "postCreateCommand": "bash ../../.devcontainer/getting-started/post-create.sh",
    "runArgs": ["--privileged", "--init"],
    "forwardPorts": [8180, 8181, 8182, 5532, 5173],
    "portsAttributes": {
        "8180": {"label": "Drasi Server API", "onAutoForward": "notify"},
        "8181": {"label": "Temporary SSE reaction", "onAutoForward": "notify"},
        "8182": {"label": "Location updates", "onAutoForward": "silent"},
        "5532": {"label": "PostgreSQL", "onAutoForward": "silent"},
        "5173": {"label": "Optional event viewer", "onAutoForward": "notify"}
    },
    "customizations": {
        "vscode": {
            "extensions": ["humao.rest-client"],
            "settings": {"editor.formatOnSave": true}
        }
    },
    "remoteUser": "vscode",
    "containerEnv": {
        "CARGO_TARGET_DIR": "/home/vscode/.cache/drasi-getting-started/target",
        "CARGO_BUILD_JOBS": "1",
        "CARGO_INCREMENTAL": "0",
        "CARGO_PROFILE_DEV_DEBUG": "0",
        "DRASI_TUTORIAL_EVALUATION": "${localEnv:DRASI_TUTORIAL_EVALUATION}"
    }
}
