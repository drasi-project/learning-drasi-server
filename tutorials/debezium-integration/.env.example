# Example environment variables for the debezium-integration tutorial
#
# Copy this file to .env and adjust as needed:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env with real credentials!

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5752
POSTGRES_HOST_PORT=5752
POSTGRES_DATABASE=building_comfort
POSTGRES_USER=drasi_user
POSTGRES_PASSWORD=drasi_password

# Drasi Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8380
LOG_LEVEL=info

# Dashboard reaction
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=3000

# Path 1 — Debezium Server → HTTP source
HTTP_SOURCE_HOST=0.0.0.0
HTTP_SOURCE_PORT=9080
# URL Debezium Server uses to reach Drasi (from inside Docker)
DEBEZIUM_SINK_HTTP_URL=http://host.docker.internal:9080/debezium

# Path 2 — Kafka Connect → Kafka source
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_HOST_PORT=19092
KAFKA_TOPIC=building.changes
KAFKA_GROUP_ID=drasi-building-comfort
CONNECT_HOST_PORT=8083
