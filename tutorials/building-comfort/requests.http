# =============================================================================
# Drasi Server Building Comfort - HTTP Requests
# =============================================================================
# Use with the VSCode REST Client extension (humao.rest-client) or similar.
# API documentation is served at http://localhost:8380/api/v1/docs/
# Run each named lookup before its paired UUID-addressed request.

@baseUrl = http://localhost:8380
@dashboardUrl = http://localhost:3000
@instanceUrl = {{baseUrl}}/api/v1/instances/building-comfort-server

### ==========================================================================
### Health & Info
### ==========================================================================

### Health check
GET {{baseUrl}}/health

### List API versions
GET {{baseUrl}}/api/versions

### Confirm the selected instance uses ComputationGraph
GET {{instanceUrl}}/runtime

### ==========================================================================
### Sources
### ==========================================================================

### List all sources
GET {{instanceUrl}}/sources

### Resolve the building-facilities source
# @name facilities
GET {{instanceUrl}}/components/by-name/building-facilities

### Get the building-facilities source status
GET {{instanceUrl}}/sources/{{facilities.response.body.$.data.id}}

### ==========================================================================
### Continuous Queries
### ==========================================================================

### List all queries
GET {{instanceUrl}}/queries

### Resolve shared room comfort
# @name roomComfort
GET {{instanceUrl}}/components/by-name/room-comfort

### Shared room comfort (feeds floor rollups, room alerts and the building view)
GET {{instanceUrl}}/queries/{{roomComfort.response.body.$.data.id}}/results

### Resolve overall building comfort
# @name buildingComfort
GET {{instanceUrl}}/components/by-name/building-comfort-level-calc

### Overall building comfort level
GET {{instanceUrl}}/queries/{{buildingComfort.response.body.$.data.id}}/results

### Resolve floor comfort
# @name floorComfort
GET {{instanceUrl}}/components/by-name/floor-comfort-level-calc

### Per-floor comfort levels
GET {{instanceUrl}}/queries/{{floorComfort.response.body.$.data.id}}/results

### Resolve room alerts
# @name roomAlert
GET {{instanceUrl}}/components/by-name/room-alert

### Rooms outside the comfortable band (alerts)
GET {{instanceUrl}}/queries/{{roomAlert.response.body.$.data.id}}/results

### Resolve floor alerts
# @name floorAlert
GET {{instanceUrl}}/components/by-name/floor-alert

### Floors outside the comfortable band (alerts)
GET {{instanceUrl}}/queries/{{floorAlert.response.body.$.data.id}}/results

### Resolve building alerts
# @name buildingAlert
GET {{instanceUrl}}/components/by-name/building-alert

### Building outside the comfortable band (alert)
GET {{instanceUrl}}/queries/{{buildingAlert.response.body.$.data.id}}/results

### ==========================================================================
### Reactions
### ==========================================================================

### List all reactions
GET {{instanceUrl}}/reactions

### Resolve the dashboard reaction
# @name dashboard
GET {{instanceUrl}}/components/by-name/building-comfort-dashboard

### Get the dashboard reaction status
GET {{instanceUrl}}/reactions/{{dashboard.response.body.$.data.id}}

### Open the dashboard in a browser instead: {{dashboardUrl}}
### The seeded "Building Comfort" dashboard is available via the dashboard API:
GET {{dashboardUrl}}/api/dashboards
