# Example environment variables for the curbside-pickup tutorial
#
# Copy this file to .env and adjust as needed:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env with real credentials!

# Retail Operations - PostgreSQL (orders)
POSTGRES_HOST=localhost
POSTGRES_PORT=5742
POSTGRES_HOST_PORT=5742
POSTGRES_DATABASE=RetailOperations
POSTGRES_USER=drasi_user
POSTGRES_PASSWORD=drasi_password

# Physical Operations - MySQL (vehicles)
MYSQL_HOST=localhost
MYSQL_PORT=3309
MYSQL_HOST_PORT=3309
MYSQL_DATABASE=PhysicalOperations
MYSQL_USER=drasi_user
MYSQL_PASSWORD=drasi_password
# The root password is used by the setup scripts to seed the database and grant
# the replication privileges the Drasi source needs.
MYSQL_ROOT_PASSWORD=root_admin

# Drasi Server settings.
SERVER_HOST=0.0.0.0
SERVER_PORT=8480
LOG_LEVEL=info

# Dashboard reaction settings.
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=3000

# Web console (webui/) - browser-based alternative to the terminal UI.
WEBUI_HOST=0.0.0.0
WEBUI_PORT=3001
