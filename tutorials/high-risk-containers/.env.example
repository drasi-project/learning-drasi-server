# Copy to .env before the first run. Never commit real webhook credentials.
CONTAINER_ENGINE=podman
# Set DOCKER_HOST to the running rootful Podman API socket for k3d.
# DOCKER_HOST=unix:///your/podman-api.sock
# K3D=/absolute/path/to/k3d

# Change ports only before creating a run, or use a new DRASI_DEMO_DIR.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5732
POSTGRES_HOST_PORT=5732
K3D_API_PORT=6550
SERVER_HOST=127.0.0.1
SERVER_PORT=8380
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3000
LOG_LEVEL=info

# The seeded demo uses high_risk_containers / drasi_user / drasi_password.
# Names for cluster, namespace, container and volume derive from the owned run.
# DRASI_RUN_ID=hrc-my-experiment
# DRASI_DEMO_DIR=/absolute/path/to/private-run-directory
# DRASI_SERVER_REPO=/absolute/path/to/drasi-server

# Enable the commented HTTP reaction in server-config.yaml before using this.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>
