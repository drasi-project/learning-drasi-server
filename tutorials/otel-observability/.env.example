# Copy to .env. Shell variables override these literal NAME=value settings.
# Never commit real credentials. This database is private demo data.
CONTAINER_ENGINE=podman
POSTGRES_PORT=5732
SERVER_PORT=8380
DASHBOARD_PORT=3000
OTEL_GRPC_PORT=14317
OTEL_HTTP_PORT=14318
CHECKOUT_CONTROL_PORT=18080
K3D_API_PORT=6551
K8S_NAMESPACE=otel-observability

# k3d requires Podman's Docker-compatible API socket. For macOS, obtain it:
# podman machine inspect --format '{{.ConnectionInfo.PodmanSocket.Path}}'
# DOCKER_HOST=unix:///absolute/path/to/podman-api.sock
# K3D=/absolute/path/to/k3d
#
# Override only if automatic host gateway detection is unsuitable:
# COLLECTOR_DRASI_ENDPOINT=192.0.2.1:14317
#
# Separate run and compiled-artifact directory (defaults to .runtime):
# DRASI_DEMO_DIR=/absolute/path/to/my-otel-run
# Shared local source builder accepts DRASI_SERVER_REPO/CARGO_TARGET_DIR.
# DRASI_SERVER_REPO=/absolute/path/to/drasi-server
