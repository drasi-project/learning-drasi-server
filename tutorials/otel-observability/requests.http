# =============================================================================
# Drasi Server OTel Observability - HTTP Requests
# =============================================================================
# Use with the VSCode REST Client extension (humao.rest-client) or similar.
# API documentation is served at http://localhost:8380/api/v1/docs/

@baseUrl = http://localhost:8380
@instanceId = otel-observability-server
@instanceUrl = {{baseUrl}}/api/v1/instances/{{instanceId}}
@dashboardUrl = http://localhost:3000
@checkoutUrl = http://localhost:18080

### ==========================================================================
### Health & Info
### ==========================================================================

### Health check
GET {{baseUrl}}/health

### Exact instance runtime identity
GET {{instanceUrl}}/runtime

### List API versions
GET {{baseUrl}}/api/versions

### ==========================================================================
### Sources
### ==========================================================================

### List all sources
GET {{instanceUrl}}/sources

### Get the PostgreSQL SLO source status
GET {{instanceUrl}}/sources/d0b24e57-1f5e-4855-98e8-fcf797dc34e5

### Get the Kubernetes source status
GET {{instanceUrl}}/sources/36a47b94-1435-4e1c-87cd-2a1270883f52

### Get the OTel source status
GET {{instanceUrl}}/sources/7de527cf-aed8-478b-93a3-c4008991ade1

### ==========================================================================
### Continuous Queries
### ==========================================================================

### List all queries
GET {{instanceUrl}}/queries

### Current health (always-on deployment/metric view)
GET {{instanceUrl}}/queries/97471d43-3175-45e4-a663-0cbf726b2739/results

### Active SLO alerts
GET {{instanceUrl}}/queries/7b55919e-aefa-4510-8f9e-4fe4b05fbf33/results

### Service dependency edges
GET {{instanceUrl}}/queries/d37d4c90-e044-4e98-a66b-6b7a6c2b7f21/results

### Missing heartbeats
GET {{instanceUrl}}/queries/fd251a01-8e67-453b-ac4a-50d6ffb1b6b3/results

### ==========================================================================
### Reactions
### ==========================================================================

### List all reactions
GET {{instanceUrl}}/reactions

### Get the dashboard reaction status
GET {{instanceUrl}}/reactions/94ac6021-1d21-4211-ae7a-bbac3158a8b7

### Seeded dashboards
GET {{dashboardUrl}}/api/dashboards

### ==========================================================================
### Checkout control API (mock service)
### ==========================================================================

### Current checkout mock state
GET {{checkoutUrl}}/state

### Spike checkout p99 latency to 920ms
POST {{checkoutUrl}}/latency/920

### Recover checkout p99 latency to 700ms
POST {{checkoutUrl}}/latency/700

### Restore healthy checkout p99 latency
POST {{checkoutUrl}}/latency/400

### Stop checkout heartbeats
POST {{checkoutUrl}}/heartbeat/off

### Resume checkout heartbeats
POST {{checkoutUrl}}/heartbeat/on
