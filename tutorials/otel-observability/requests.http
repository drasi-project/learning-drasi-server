# =============================================================================
# Drasi Server OTel Observability - HTTP Requests
# =============================================================================
# Use with the VSCode REST Client extension (humao.rest-client) or similar.
# API documentation is served at http://localhost:8380/api/v1/docs/
# Run each named lookup before its paired UUID-addressed request.

@baseUrl = http://localhost:8380
@instanceId = otel-observability-server
@instanceUrl = {{baseUrl}}/api/v1/instances/{{instanceId}}
@dashboardUrl = http://localhost:3000
@checkoutUrl = http://localhost:18080

### ==========================================================================
### Health & Info
### ==========================================================================

### Health check
GET {{baseUrl}}/health

### Exact instance runtime identity
GET {{instanceUrl}}/runtime

### List API versions
GET {{baseUrl}}/api/versions

### ==========================================================================
### Sources
### ==========================================================================

### List all sources
GET {{instanceUrl}}/sources

### Resolve the PostgreSQL SLO source
# @name sloSource
GET {{instanceUrl}}/components/by-name/slo

### Get the PostgreSQL SLO source status
GET {{instanceUrl}}/sources/{{sloSource.response.body.$.data.id}}

### Resolve the Kubernetes source
# @name kubernetes
GET {{instanceUrl}}/components/by-name/k8s

### Get the Kubernetes source status
GET {{instanceUrl}}/sources/{{kubernetes.response.body.$.data.id}}

### Resolve the OTel source
# @name otelSource
GET {{instanceUrl}}/components/by-name/otel

### Get the OTel source status
GET {{instanceUrl}}/sources/{{otelSource.response.body.$.data.id}}

### ==========================================================================
### Continuous Queries
### ==========================================================================

### List all queries
GET {{instanceUrl}}/queries

### Resolve current health
# @name currentHealth
GET {{instanceUrl}}/components/by-name/current-health

### Current health (always-on deployment/metric view)
GET {{instanceUrl}}/queries/{{currentHealth.response.body.$.data.id}}/results

### Resolve SLO alerts
# @name sloAlert
GET {{instanceUrl}}/components/by-name/slo-alert

### Active SLO alerts
GET {{instanceUrl}}/queries/{{sloAlert.response.body.$.data.id}}/results

### Resolve service dependencies
# @name serviceDependencies
GET {{instanceUrl}}/components/by-name/service-dependencies

### Service dependency edges
GET {{instanceUrl}}/queries/{{serviceDependencies.response.body.$.data.id}}/results

### Resolve missing heartbeats
# @name missingHeartbeat
GET {{instanceUrl}}/components/by-name/missing-heartbeat

### Missing heartbeats
GET {{instanceUrl}}/queries/{{missingHeartbeat.response.body.$.data.id}}/results

### ==========================================================================
### Reactions
### ==========================================================================

### List all reactions
GET {{instanceUrl}}/reactions

### Resolve the dashboard reaction
# @name dashboard
GET {{instanceUrl}}/components/by-name/otel-observability-dashboard

### Get the dashboard reaction status
GET {{instanceUrl}}/reactions/{{dashboard.response.body.$.data.id}}

### Seeded dashboards
GET {{dashboardUrl}}/api/dashboards

### ==========================================================================
### Checkout control API (mock service)
### ==========================================================================

### Current checkout mock state
GET {{checkoutUrl}}/state

### Spike checkout p99 latency to 920ms
POST {{checkoutUrl}}/latency/920

### Recover checkout p99 latency to 700ms
POST {{checkoutUrl}}/latency/700

### Restore healthy checkout p99 latency
POST {{checkoutUrl}}/latency/400

### Stop checkout heartbeats
POST {{checkoutUrl}}/heartbeat/off

### Resume checkout heartbeats
POST {{checkoutUrl}}/heartbeat/on
